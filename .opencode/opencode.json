{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "omni-dev",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git stash*": "deny",
      "git reset --hard*": "ask",
      "git rebase*": "ask",
      "rm -rf*": "ask",
      "pkill*": "deny",
      "killall*": "deny",
      "launchctl*": "deny",
      "sudo*": "deny"
    }
  }
}
