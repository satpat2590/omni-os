google-token.json
google-oauth.json
*-token.json
google-service-account.json
google_client_secret.json
*client_secret*.json

# Holds a Google OAuth client secret; was committed by the 2026-10-07 recovery commit. Never track it.
write-read-state.json

# Generated by mindmap.py / render_mindmap.py from this machine's own Atma data
static/graph.json
static/mindmap.png
static/mindmap_nodes.json

# pipeline heartbeats (append-only run logs)
state/

# Virtualenvs, at any depth (atma/api, atma/app, atma/mcp each have their own)
.venv/

# Editable-install metadata
*.egg-info/

